# ==============================================================================
# International Student Deadline & Risk Agent — Frontend Environment Configuration
# ==============================================================================
#
# Vite exposes variables prefixed with VITE_ to the browser client.
# NEVER put private credentials, Google service keys, or OpenAI API keys in this file.
#
# n8n Webhook URL configuration:
#
# 1. DEVELOPMENT / TESTING:
#    When testing in the n8n workflow editor, use the TEST webhook URL.
#    Note: The n8n editor must be open with "Listen for test event" / "Test step" active.
#    Example: https://<instance>.app.n8n.cloud/webhook-test/student-risk-chat
#
# 2. PRODUCTION:
#    When the n8n workflow is published and set to "Active", switch to the PRODUCTION webhook URL.
#    Example: https://<instance>.app.n8n.cloud/webhook/student-risk-chat
#
VITE_N8N_WEBHOOK_URL=https://ai-agent-apu.app.n8n.cloud/webhook-test/student-risk-chat

